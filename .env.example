# Copy to .env and fill values. Never commit real secrets.
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (credentials are enabled for these only).
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://shopwise:shopwise@localhost:5433/shopwise?schema=public

# >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_TOKEN_TTL_MINUTES=60
COOKIE_SECURE=false

LOG_LEVEL=info
